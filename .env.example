NODE_ENV=development
DATABASE_PATH=./data/lbth.sqlite
PUBLIC_APP_URL=http://localhost:3000
PORT=3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_BOOTSTRAP_EMAIL=
# 請設定穩定且至少 32 位元組的隨機密鑰；正式環境必填。
AUTH_HANDOFF_ENCRYPTION_KEY=
# 暫停 TOTP 時不需要；日後恢復 TOTP 時設定至少 32 位元組的隨機秘密值。
# ADMIN_TOTP_ENCRYPTION_KEY=
# 此金鑰會提供給瀏覽器載入 Google Maps JavaScript API；僅啟用必要 API，並設定 HTTP referrer 限制、用量上限及費用警示。
GOOGLE_MAPS_API_KEY=
BACKUP_DIRECTORY=./backups
BACKUP_INTERVAL_MS=86400000
TRUST_PROXY_HOPS=0
